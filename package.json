{
  "name": "nodejs-store",
  "version": "6.0.1",
  "description": "Multi-backend data layer for Node.js (MongoDB, MySQL, SQLite, PostgreSQL, local disk): pure JSON schemas, GQL tree queries compiled to a single native query, GROUP BY/HAVING aggregation, computed columns, soft-delete and role-based access control",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "README.en.md",
    "llms.txt",
    "llms-full.txt",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test:coverage": "c8 --all --include \"src/**\" -x \"**/rust-store/**\" --reporter=text --reporter=html --check-coverage --statements 90 --lines 90 --functions 85 --branches 75 node scripts/test.js",
    "lint": "eslint ."
  },
  "keywords": [
    "mongodb",
    "mysql",
    "sqlite",
    "postgresql",
    "postgres",
    "local-disk",
    "embedded",
    "data-layer",
    "query-builder",
    "odm",
    "orm-alternative",
    "mongoose-alternative",
    "prisma-alternative",
    "gql",
    "json-schema",
    "multi-database",
    "cross-database",
    "multi-tenant",
    "acl",
    "rbac",
    "access-control",
    "row-level-security",
    "aggregation",
    "group-by",
    "computed-columns",
    "soft-delete",
    "ai-agent",
    "llm-tool",
    "query-validation",
    "natural-language-query",
    "node"
  ],
  "author": "丁滔 <coen_ddt@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coenddt/nodejs-store.git"
  },
  "bugs": {
    "url": "https://github.com/coenddt/nodejs-store/issues"
  },
  "homepage": "https://coenddt.github.io/nodejs-store/",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "mongodb": "^7.9.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "rust-store-node": "^6.0.5"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "store-gateway-node": ">=0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  }
}
