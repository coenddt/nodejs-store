{
  "name": "nodejs-store",
  "version": "2.0.1",
  "description": "Multi-backend data layer for Node.js (MongoDB, MySQL, SQLite, PostgreSQL): pure JSON schemas, GQL tree queries compiled to a single native query, GROUP BY/HAVING aggregation, computed columns, soft-delete and role-based access control",
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "llms.txt",
    "llms-full.txt",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test:coverage": "c8 --all --include \"src/**\" -x \"**/rust-store/**\" --reporter=text --reporter=html --check-coverage --statements 90 --lines 90 --functions 85 --branches 75 node scripts/test.js",
    "lint": "eslint ."
  },
  "keywords": [
    "mongodb",
    "mysql",
    "sqlite",
    "postgresql",
    "postgres",
    "data-layer",
    "query-builder",
    "odm",
    "orm-alternative",
    "mongoose-alternative",
    "prisma-alternative",
    "gql",
    "json-schema",
    "multi-database",
    "cross-database",
    "multi-tenant",
    "acl",
    "rbac",
    "access-control",
    "row-level-security",
    "aggregation",
    "group-by",
    "computed-columns",
    "soft-delete",
    "node"
  ],
  "author": "leo <coen_ddt@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coenddt/nodejs-store.git"
  },
  "bugs": {
    "url": "https://github.com/coenddt/nodejs-store/issues"
  },
  "homepage": "https://github.com/coenddt/nodejs-store#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "rust-store-node": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "c8": "^10.1.3",
    "eslint": "^9.39.2",
    "globals": "^15.15.0"
  }
}
